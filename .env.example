# انسخ هذا الملف إلى .env واملأ القيم محليًا.
# ملف .env غير متتبَّع في git ولا يُرفع أبدًا — القيمة الحقيقية تبقى على جهازك.
# القيم تُمرَّر وقت البناء، مثال:
#   flutter build web --dart-define=CLOUDINARY_CLOUD_NAME=<اسم_السحابة> --dart-define=CLOUDINARY_UPLOAD_PRESET=<البريسيت>

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
IMG_BB_API_KEY=
