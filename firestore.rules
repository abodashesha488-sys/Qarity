rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────── دوال مساعدة ─────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // الوصول للأدمن عبر الدور فقط (users/{uid}.role == 'admin').
    // لإضافة أول مدير: أنشئ مستخدمك ثم عيّن users/<uid>.role = 'admin' من
    // Firebase Console. لا نربط القواعد ببريد ثابت حتى لا يصبح نقطة فشل/تسريب.
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // مدير المركز الطبي: دوره medical_admin (أو مدير عام). مسؤول عن محتوى المركز
    // ومراجعة المدخلات الطبية.
    function isMedicalAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'medical_admin'];
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // يسمح للمستخدم بتحديث حقول التفاعل فقط (عدّادات) دون المساس بالمحتوى أو حالة الموافقة
    function interactionOnly() {
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['likes', 'likedBy', 'comments', 'views', 'rating', 'reviewCount']);
    }

    // ───────────────────────── المستخدمون ─────────────────────────
    match /users/{userId} {
      // القراءة الفردية مسموحة للمسجّلين (عرض اسم/هاتف البائع في الطلبات والمراجعات)
      // أما سرد القائمة كلها فلصلاحيات الأدمن فقط (لوحة التحكم ← المستخدمون).
      allow get: if isSignedIn();
      allow list: if isAdmin();

      // الإنشاء للمالك نفسه فقط، بحساب عادي، ولا يُنشئ نفسه أدمن/مدير طبي/معطّلاً.
      allow create: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.role != 'admin'
                    && request.resource.data.role != 'medical_admin'
                    && request.resource.data.role != 'moderator'
                    && request.resource.data.role != 'seller'
                    && request.resource.data.isActive == true;

      // الأدمن (مدير عام) يغيّر أي شيء في أي حساب (الأدوار/النوع/التفعيل).
      // المالك يحدّث بياناته فقط دون المساس بحقول الصلاحيات:
      //   role / sellerType / isActive
      allow update: if isAdmin()
                    || (isOwner(userId)
                        && !request.resource.data.diff(resource.data)
                             .affectedKeys().hasAny(['role', 'sellerType', 'isActive'])
                        && (!('role' in request.resource.data)
                            || request.resource.data.role == resource.data.role)
                        && (!('isActive' in request.resource.data)
                            || request.resource.data.isActive == resource.data.isActive));
      allow delete: if isAdmin();
    }

    // ───────────────────────── الأخبار ─────────────────────────
    match /news/{docId} {
      allow list, get: if true;
      // كل خبر جديد يجب أن يبدأ غير موافق عليه
      allow create: if isSignedIn() && request.resource.data.isApproved == false;
      // المالك يستطيع مزامنة اسمه المعروض فقط (cascade تغيير الملف الشخصي)
      allow update: if isAdmin() || interactionOnly()
        || (isSignedIn() && resource.data.authorId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authorName']));
      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
        allow update, delete: if isAdmin() || request.auth.uid == resource.data.userId;
      }
    }

    // ───────────────────────── منتجات السوق ─────────────────────────
    match /market_products/{docId} {
      allow list, get: if true;
      allow create: if isSignedIn() && request.resource.data.isApproved == false;
      // البائع: تفاعل + مزامنة اسمه المعروض
      allow update: if isAdmin() || interactionOnly()
        || (isSignedIn() && resource.data.sellerId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sellerName','sellerType']));
      allow delete: if isAdmin();

      match /likes/{userId} {
        allow read: if true;
        // المالك يكتب إعجابه — والأدمن يستطيع مسحها عند تنظيف منتج محذوف
        allow write: if isOwner(userId) || isAdmin();
      }
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
        allow update, delete: if isAdmin() || request.auth.uid == resource.data.userId;
      }
    }

    // ───────────────────────── العزاء ─────────────────────────
    match /obituaries/{docId} {
      allow list, get: if true;
      allow create: if isSignedIn() && request.resource.data.isApproved == false;
      allow update: if isAdmin() || interactionOnly();
      allow delete: if isAdmin();
    }

    // ───────────────────────── المناسبات ─────────────────────────
    match /occasions/{docId} {
      allow list, get: if true;
      allow create: if isSignedIn() && request.resource.data.isApproved == false;
      allow update: if isAdmin() || interactionOnly();
      allow delete: if isAdmin();
    }

    // ───────────────────────── المنتدى ─────────────────────────
    match /forum_posts/{docId} {
      allow list, get: if true;
      allow create: if isSignedIn() && request.resource.data.isApproved == false;
      allow update: if isAdmin() || interactionOnly()
        || (isSignedIn() && resource.data.userId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userName','userPhotoUrl']));
      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
        allow update, delete: if isAdmin() || request.auth.uid == resource.data.userId;
      }
    }

    // ───────────────────────── طلبات الخدمات ─────────────────────────
    match /service_requests/{docId} {
      allow get: if isAdmin() || resource.data.userId == request.auth.uid;
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if isAdmin();
    }

    // ───────────────────────── الطلبات (السوق) ─────────────────────────
    match /orders/{docId} {
      allow get: if isAdmin()
                 || resource.data.buyerId == request.auth.uid
                 || resource.data.sellerId == request.auth.uid;
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.buyerId;
      // المشتري أو البائع أو الأدمن يستطيع تحديث حالة الطلب
      allow update: if isAdmin()
                    || resource.data.buyerId == request.auth.uid
                    || resource.data.sellerId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ───────────────────────── سجل النشاط (للأدمن) ─────────────────────────
    match /activity_log/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    // ───────────────────────── جهات الاتصال الطارئة ─────────────────────────
    match /emergency_contacts/{docId} {
      allow list, get: if true;
      allow create, update, delete: if isAdmin();
    }

    // ───────────────────────── معلومات القرية ─────────────────────────
    match /village_info/{docId} {
      allow list, get: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─────────────────────── التنبيه العاجل للقرية ───────────────────────
    // قراءة عامة لكل الشاشات؛ الإنشاء/التعديل/الحذف للمدير العام فقط.
    match /village_alerts/{docId} {
      allow list, get: if true;
      allow create, update, delete: if isAdmin();
    }

    // ───────────────────────── التعازي (مجموعة مستقلة) ─────────────────────────
    match /condolences/{docId} {
      allow list, get: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if isAdmin() || request.auth.uid == resource.data.userId;
    }

    // ───────────────────────── حضور المناسبات ─────────────────────────
    match /occasion_attendees/{docId} {
      allow list, get: if isSignedIn();
      // الإنشاء يتحقق من request.resource، والحذف يتحقق من resource (الوثيقة القائمة)
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      // مزامنة اسم الحاضر عند تغيير اسمه
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userName']));
    }

    // ───────────────────────── مراجعات المنتجات ─────────────────────────
    match /product_reviews/{docId} {
      allow list, get: if true;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if isAdmin() || request.auth.uid == resource.data.userId;
    }

    // ───────────────────────── مراجعات البائعين (reviews) ─────────────────────────
    match /reviews/{docId} {
      allow list, get: if true;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if isAdmin() || request.auth.uid == resource.data.userId;
    }

    // ───────────────────────── ملفات البائعين ─────────────────────────
    match /seller_profiles/{docId} {
      allow list, get: if true;
      // الأدمن يستطيع إنشاء/تعديل أي ملف (عند الموافقة)، والمالك يعدّل ملفه
      allow create, update: if isAdmin() || isOwner(docId);
      allow delete: if isAdmin();
    }

    // ───────────────────────── طلبات أن تكون بائعاً ─────────────────────────
    match /seller_requests/{docId} {
      // الأدمن يرى الكل، والمقدِّم يرى طلبه فقط
      allow get: if isAdmin() || resource.data.userId == request.auth.uid;
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if isAdmin();
    }

    // ───────────────────────── تنبيهات المخزون ─────────────────────────
    match /stock_alerts/{docId} {
      allow list, get: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      // الأدمن يحذفها ضمن تنظيف منتج محذوف
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
    }

    // ───────────────────────── الإشعارات ─────────────────────────
    match /notifications/{docId} {
      allow get: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow delete: if isAdmin();
    }

    // ───────────────────────── دليل الهاتف ─────────────────────────
    match /phone_directory/{docId} {
      allow list, get: if true;
      // لا يُنشئ المستخدم جهة اتصال معتمدة ذاتياً — تبدأ غير موافق عليه باسمه
      allow create: if isAdmin() || (isSignedIn()
          && request.resource.data.isApproved == false
          && request.auth.uid == request.resource.data.submittedBy);
      // مقدّم البيان يعدّل إدخاله غير المعتمد فقط دون المساس بالموافقة
      allow update: if isAdmin()
          || (isSignedIn() && resource.data.submittedBy == request.auth.uid
              && resource.data.isApproved == false
              && !request.resource.data.diff(resource.data)
                   .affectedKeys().hasAny(['isApproved']));
      allow delete: if isAdmin();
    }

    // ───────────────────────── دليل الخدمات (فنيون/زراعية/تعليمية) ─────────────────────────
    match /service_providers/{docId} {
      allow list, get: if true;
      // كل إدخال جديد يبدأ غير موافق عليه، ومن مقدم الطلب نفسه
      allow create: if isSignedIn()
                    && request.auth.uid == request.resource.data.submittedBy
                    && request.resource.data.isApproved == false;
      // الأدمن: مراجعة كاملة (موافقة/تمييز). المالك: تعديل مدخلاته غير المعتمدة فقط دون المساس بحالة الموافقة.
      // أي مستخدم مسجّل: تحديث إحصاءات التقييم فقط (rating/ratingCount) عند التعليق.
      allow update: if isAdmin()
                    || (isSignedIn() && resource.data.submittedBy == request.auth.uid
                        && resource.data.isApproved == false
                        && !request.resource.data.diff(resource.data)
                             .affectedKeys().hasAny(['isApproved']))
                    || (isSignedIn()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['rating', 'ratingCount']));
      allow delete: if isAdmin();

      // تقييمات وتعليقات المستخدمين على البيانات
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
        allow update, delete: if isAdmin() || request.auth.uid == resource.data.userId;
      }
    }

    // ───────────────────────── المفقودات (أشياء مفقودة/موجودة) ─────────────────────────
    match /lost_items/{docId} {
      allow list, get: if true;
      // كل إعلان يبدأ غير معتمد، ومن صاحبه نفسه
      allow create: if isSignedIn()
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.isApproved == false;
      // الأدمن: مراجعة كاملة. المالك: يبدّل حالة «تم التسليم» فقط بعد الاعتماد،
      // أو يعدّل إعلانَه غير المعتمد دون المساس بالموافقة.
      allow update: if isAdmin()
                    || (isSignedIn() && resource.data.userId == request.auth.uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['isResolved']))
                    || (isSignedIn() && resource.data.userId == request.auth.uid
                        && resource.data.isApproved == false
                        && !request.resource.data.diff(resource.data)
                             .affectedKeys().hasAny(['isApproved']));
      allow delete: if isAdmin();
    }

    // محلات القرية — الإنشاء لصاحب المحل (يبدأ غير معتمد)، والتعديل لصاحبه أو الأدمن
    match /shops/{docId} {
      allow list, get: if true;
      allow create: if isAdmin()
          || (isSignedIn()
              && request.auth.uid == request.resource.data.ownerUid
              && request.resource.data.isApproved == false);
      // المالك يحدّث بيانات محله دون المساس بحالة الموافقة
      allow update: if isAdmin()
          || (resource.data.ownerUid == request.auth.uid
              && !request.resource.data.diff(resource.data)
                   .affectedKeys().hasAny(['isApproved']));
      allow delete: if isAdmin();
    }

    // سلع مطلوبة
    match /buy_requests/{docId} {
      allow list, get: if true;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow update: if isAdmin() || resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() || resource.data.userId == request.auth.uid;
    }

    // تبرعات
    match /donations/{docId} {
      allow list, get: if true;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow update: if isAdmin() || resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() || resource.data.userId == request.auth.uid;
    }

    // ───────────────────────── سجل الأسعار ─────────────────────────
    match /price_history/{docId} {
      allow list, get: if true;
      allow create, update, delete: if isAdmin();
    }

    // ───────────────────────── الخدمات الطبية ─────────────────────────
    // عيادات المركز الطبي الخيري: يديرها مدير المركز الطبي، والعام للقراءة.
    match /medical_center_clinics/{docId} {
      allow list, get: if true;
      allow create, update, delete: if isMedicalAdmin();
    }

    // عيادات القرية: مدخلات مستخدمين (تبدأ غير موافق عليها) + موافقة الأدمن/مدير المركز.
    match /village_clinics/{docId} {
      allow list, get: if true;
      allow create: if isSignedIn() && request.resource.data.isApproved == false;
      allow update, delete: if isMedicalAdmin()
                            || (isSignedIn() && resource.data.submittedBy == request.auth.uid
                                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isApproved']) == false
                                && resource.data.isApproved == false);
      // المتابعة: المستخدم يستطيع تعديل مدخلاته غير المعتمدة فقط
    }

    // صيدليات القرية: نفس نهج العيادات.
    match /pharmacies/{docId} {
      allow list, get: if true;
      allow create: if isSignedIn() && request.resource.data.isApproved == false;
      allow update, delete: if isMedicalAdmin()
                            || (isSignedIn() && resource.data.submittedBy == request.auth.uid
                                && resource.data.isApproved == false);
    }

    // معامل التحاليل: مدخلات مستخدمين (تبدأ غير موافق عليها) + موافقة الأدمن/مدير المركز.
    match /medical_labs/{docId} {
      allow list, get: if true;
      allow create: if isSignedIn() && request.resource.data.isApproved == false;
      allow update, delete: if isMedicalAdmin()
                            || (isSignedIn() && resource.data.submittedBy == request.auth.uid
                                && resource.data.isApproved == false);
    }

    // متبرعو الدم: إضافة من المالك، ظهور عام بعد الموافقة، تعديل المالك لبياناته.
    match /blood_donors/{docId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if isSignedIn()
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.isApproved == false;
      // غير المعتمد: تعديله كامل. المعتمد: صاحبُه يحدّث بياناته الشخصية فقط (بما فيها الاسم).
      allow update: if isMedicalAdmin()
                    || (isSignedIn() && resource.data.userId == request.auth.uid
                        && request.resource.data.isApproved == false)
                    || (isSignedIn() && resource.data.userId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['name','phone','age','gender','address','isAvailable','lastDonation','bloodType']));
      allow delete: if isMedicalAdmin()
                    || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // طلبات التبرع بالدم: المالك ينشئ/يغلق/يحدّث بيانات طلبه، والموافقة والنشر للأدمن/مدير المركز.
    match /blood_requests/{docId} {
      allow list, get: if true;
      allow create: if isSignedIn()
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.isApproved == false;
      // المالك: الإغلاق (status) أو مزامنة اسم مقدم الطلب؛ ولا يلمس isApproved.
      allow update: if isMedicalAdmin()
                    || (isSignedIn() && resource.data.userId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status','requesterName','phone']));
      allow delete: if isMedicalAdmin();
    }

    // ───────────────────────── محتوى «تعرف على القرية» ─────────────────────────
    // قراءة عامة للجميع؛ الإنشاء/التعديل/الحذف للأدمن فقط (لا مراجعة — الأدمن هو المؤلف).
    match /village_history/{docId} {
      allow list, get: if true;
      allow write: if isAdmin();
    }

    match /village_figures/{docId} {
      allow list, get: if true;
      allow write: if isAdmin();
    }

    match /village_archive_photos/{docId} {
      allow list, get: if true;
      allow write: if isAdmin();
    }

    match /village_institutions/{docId} {
      allow list, get: if true;
      allow write: if isAdmin();
    }

    // ───────────────────────── الإعلانات الدعائية المنبثقة ─────────────────────────
    // قراءة عامة (تظهر لكل المستخدمين) — الإنشاء/التعديل/الحذف للأدمن فقط.
    match /promos/{docId} {
      allow list, get: if true;
      allow write: if isAdmin();
    }
  }
}