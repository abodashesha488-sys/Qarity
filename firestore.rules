rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────── دوال مساعدة ─────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // الحساب المفعّل فقط يكتب. التعطيل من لوحة الإدارة يجب أن يمنع الإضافة
    // والتعديل حتى لو بقيت جلسة قديمة عند المستخدم أو استعمل عميلًا مباشرًا،
    // لأن بقية Gates كلها جانب العميل. الوثيقة غير الموجودة (حساب لم يُنشأ
    // ملفه بعد) تُحسب مفعّلة حتى لا تنكسر خطوة الإنشاء الأولى، وغياب الحقل
    // (حسابات قديمة) مفعّل أيضًا.
    function accountActive() {
      return isSignedIn()
        && (!('isActive' in me().data) || me().data.isActive != false);
    }

    // الوصول للأدمن عبر الدور فقط (users/{uid}.role == 'admin').
    // لإضافة أول مدير: أنشئ مستخدمك ثم عيّن users/<uid>.role = 'admin' من
    // Firebase Console. لا نربط القواعد ببريد ثابت حتى لا يصبح نقطة فشل/تسريب.
    // المدير العام فقط (role == 'admin'). يُستخدم حيث تُحفظ صلاحياته الحصرية:
    // حماية حساب المدير العام من الحذف أو التنحية بواسطة الأدمن المساعد.
    function isGeneralAdmin() {
      return accountActive() && me().data.role == 'admin';
    }

    // أي مدير: المدير العام أو «الأدمن المساعد» (assistant_admin).
    // للأدمن المساعد نفس صلاحيات المدير العام في إدارة المحتوى كله،
    // ما عدا حذف/تنحية المدير العام (انظر مجموعة users أدناه).
    function isAdmin() {
      return accountActive() && me().data.role in ['admin', 'assistant_admin'];
    }

    // مدير المركز الطبي الخيري: دوره medical_admin (أو أي مدير). صلاحيته محصورة
    // في عيادات المركز الخيري (medical_center_clinics) فقط — لا يراجع بقية
    // محتوى الخدمات الطبي (عيادات القرية/الصيدليات/المعامل/النظارات/بنك الدم)،
    // فتلك للمدير العام وأدمنه المساعد عبر لوحة التحكم وحدها.
    function isCenterAdmin() {
      return accountActive() &&
        me().data.role in ['admin', 'assistant_admin', 'medical_admin'];
    }

    function isAgriculturalAdmin() {
      return accountActive() &&
        me().data.role in ['admin', 'assistant_admin', 'agricultural_admin'];
    }

    function isOwner(userId) {
      return accountActive() && request.auth.uid == userId;
    }

    // يسمح للمستخدم بتحديث حقول التفاعل فقط (عدّادات) دون المساس بالمحتوى أو حالة الموافقة
    function interactionOnly() {
      return accountActive()
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['likes', 'likedBy', 'comments', 'views', 'rating', 'reviewCount']);
    }

    // ─────────────── تعديل المالك وحذفه لإضافته (قاعدة عامة) ───────────────
    // المستخدم يعدّل إضافاته ويحذفها في أي وقت، قبل الاعتماد وبعده. تعديل
    // المالك يمرّ من هنا بشروط ثلاثة، وكلها محسوبة على **الوثيقة الناتجة**
    // بعد الكتابة (لا على الرقعة المرسلة)، فلا يمكن التحايل بحذف الحقل:
    //   (١) الوثيقة له، وتظل له: معرّف المالك في المستند الحالي وفي الناتج
    //       هو معرّف الطلب نفسه — فاستحالت نقل ملكية إضافة إلى شخص آخر.
    //   (٢) النتيجة غير معتمدة: فكل تعديل يُرجع المحتوى إلى طابور المراجعة
    //       تلقائيًا، ولا يملك أي مستخدم أن يمنح نفسه اعتمادًا (هذا هو وجه
    //       «منع isApproved» — المالك لا يكتب الموافقة، بل يفقدها).
    // الحذف لا يحتاج مراجعة: لا محتوى يبقى ليُنظَر فيه، فهو فوري للمالك.
    // تُضاف إلى هذا الشرط في كل مجموعة رُخصةُ تفاعل المالك (اسمه/صورته
    // المطبّقة من ملفه) أو رُخصة حالة خاصة به (إغلاق طلب، تم التسليم، تجديد
    // عرض مميز) لأن هذه الكتابات لا تعدّل المحتوى ولا تستحق إعادة مراجعة.
    function ownerEdit(ownerId, incomingOwnerId) {
      return accountActive()
        && ownerId == request.auth.uid
        && incomingOwnerId == request.auth.uid
        && request.resource.data.isApproved == false;
    }

    function ownerDelete(ownerId) {
      return accountActive() && ownerId == request.auth.uid;
    }

    // ───────────────────────── المستخدمون ─────────────────────────
    match /users/{userId} {
      // القراءة الفردية مسموحة للمسجّلين (عرض اسم/هاتف البائع في الطلبات والمراجعات)
      // أما سرد القائمة كلها فلصلاحيات الأدمن فقط (لوحة التحكم ← المستخدمون).
      allow get: if isSignedIn();
      allow list: if isAdmin();

      // الإنشاء للمالك نفسه فقط، بحساب عادي، ولا يُنشئ نفسه أدمن/أدمن مساعد/مدير طبي/معطّلاً.
      allow create: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.role != 'admin'
                    && request.resource.data.role != 'assistant_admin'
                    && request.resource.data.role != 'medical_admin'
                    && request.resource.data.role != 'moderator'
                    && request.resource.data.role != 'seller'
                    && request.resource.data.role != 'agricultural_admin'
                    && request.resource.data.isActive == true;

      // المدير العام يغيّر أي شيء في أي حساب (الأدوار/النوع/التفعيل).
      // الأدمن المساعد يدير بقية الحالات، لكنه لا يستطيع المساس بحساب
      // المدير العام إطلاقاً (لا حذف ولا تنحية الدور) — حماية مالك التطبيق.
      // المالك يحدّث بياناته فقط دون المساس بحقول الصلاحيات:
      //   role / sellerType / isActive
      allow update: if isGeneralAdmin()
                    || (isAdmin() && resource.data.role != 'admin')
                    || (isOwner(userId)
                        && !request.resource.data.diff(resource.data)
                             .affectedKeys().hasAny(['role', 'sellerType', 'isActive'])
                        && (!('role' in request.resource.data)
                            || request.resource.data.role == resource.data.role)
                        && (!('isActive' in request.resource.data)
                            || request.resource.data.isActive == resource.data.isActive));
      // المدير العام يحذف أي حساب. الأدمن المساعد يحذف كل الحسابات
      // ما عدا حساب المدير العام.
      allow delete: if isGeneralAdmin()
                    || (isAdmin() && resource.data.role != 'admin');
    }

    // ───────────────────────── الأخبار ─────────────────────────
    match /news/{docId} {
      allow list, get: if true;
      // كل خبر جديد يجب أن يبدأ غير موافق عليه
      allow create: if accountActive() && request.resource.data.isApproved == false;
      // المالك: (أ) مزامنة اسمه المعروض فقط (cascade تغيير الملف الشخصي — يبقى
      // الخبر معتمدًا لأنه لا يعدّل مضمونه)، و(ب) تعديل خبره في أي وقت فيعود
      // إلى المراجعة، دون لمس اسمه. والحذف فوري له.
      allow update: if isAdmin() || interactionOnly()
        || (accountActive() && resource.data.authorId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authorName']))
        || (ownerEdit(resource.data.authorId, request.resource.data.authorId)
            && !request.resource.data.diff(resource.data)
                 .affectedKeys().hasAny(['authorName']));
      allow delete: if isAdmin() || ownerDelete(resource.data.authorId);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if accountActive() && request.auth.uid == request.resource.data.userId;
        allow update, delete: if isAdmin() || (accountActive() && request.auth.uid == resource.data.userId);
      }
    }

    // ───────────────────────── منتجات السوق ─────────────────────────
    match /market_products/{docId} {
      allow list, get: if true;
      allow create: if accountActive() && request.resource.data.isApproved == false;
      // البائع: تفاعل + مزامنة اسمه/رتبته المعروضة (لا تعدّل مضمون المنتج)
      // + تعديل منتجه في أي وقت فيعود للمراجعة، وحذفه فورًا.
      allow update: if isAdmin() || interactionOnly()
        || (accountActive() && resource.data.sellerId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sellerName','sellerType']))
        || (ownerEdit(resource.data.sellerId, request.resource.data.sellerId)
            && !request.resource.data.diff(resource.data)
                 .affectedKeys().hasAny(['sellerName','sellerType']));
      allow delete: if isAdmin() || ownerDelete(resource.data.sellerId);

      match /likes/{userId} {
        allow read: if true;
        // المالك يكتب إعجابه — والأدمن يستطيع مسحها عند تنظيف منتج محذوف
        allow write: if isOwner(userId) || isAdmin();
      }
      match /comments/{commentId} {
        allow read: if true;
        allow create: if accountActive() && request.auth.uid == request.resource.data.userId;
        allow update, delete: if isAdmin() || (accountActive() && request.auth.uid == resource.data.userId);
      }
    }

    // ───────────────────────── العزاء ─────────────────────────
    // نعوة المستخدم له: يعيد تحريرها في أي وقت (فتعود للمراجعة) ويحذفها فورًا.
    // حقل المالك `submittedBy` تكتبه الخدمة وقت الإنشاء.
    match /obituaries/{docId} {
      allow list, get: if true;
      allow create: if accountActive() && request.resource.data.isApproved == false;
      allow update: if isAdmin() || interactionOnly()
                    || ownerEdit(resource.data.submittedBy,
                                 request.resource.data.submittedBy);
      allow delete: if isAdmin() || ownerDelete(resource.data.submittedBy);
    }

    // ───────────────────────── المناسبات ─────────────────────────
    match /occasions/{docId} {
      allow list, get: if true;
      allow create: if accountActive() && request.resource.data.isApproved == false;
      allow update: if isAdmin() || interactionOnly()
                    || ownerEdit(resource.data.submittedBy,
                                 request.resource.data.submittedBy);
      allow delete: if isAdmin() || ownerDelete(resource.data.submittedBy);
    }

    // ───────────────────────── المنتدى ─────────────────────────
    match /forum_posts/{docId} {
      allow list, get: if true;
      allow create: if accountActive() && request.resource.data.isApproved == false;
      // الكاتب: مزامنة اسمه/صورته من ملفه (يبقى المنشور معتمدًا)، أو تعديل
      // منشوره في أي وقت فيعود للمراجعة دون لمس نسبه، أو حذفه فورًا.
      allow update: if isAdmin() || interactionOnly()
        || (accountActive() && resource.data.userId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userName','userPhotoUrl']))
        || (ownerEdit(resource.data.userId, request.resource.data.userId)
            && !request.resource.data.diff(resource.data)
                 .affectedKeys().hasAny(['userName','userPhotoUrl']));
      allow delete: if isAdmin() || ownerDelete(resource.data.userId);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if accountActive() && request.auth.uid == request.resource.data.userId;
        // الحذف للأدمن أو الأدمن المساعد (الإشراف) أو صاحب التعليق نفسه.
        allow update, delete: if isAdmin() || (accountActive() && request.auth.uid == resource.data.userId);
      }
    }

    // ───────────────────────── طلبات الخدمات ─────────────────────────
    match /service_requests/{docId} {
      allow get: if isAdmin() || resource.data.userId == request.auth.uid;
      allow list: if isAdmin();
      allow create: if accountActive() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if isAdmin();
    }

    // ───────────────────────── الطلبات (السوق) ─────────────────────────
    match /orders/{docId} {
      allow get: if isAdmin()
                 || resource.data.buyerId == request.auth.uid
                 || resource.data.sellerId == request.auth.uid;
      allow list: if isAdmin();
      allow create: if accountActive() && request.auth.uid == request.resource.data.buyerId;
      // المشتري أو البائع أو الأدمن يستطيع تحديث حالة الطلب
      allow update: if isAdmin()
                    || resource.data.buyerId == request.auth.uid
                    || resource.data.sellerId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ───────────────────────── سجل النشاط (للأدمن) ─────────────────────────
    match /activity_log/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    // ───────────────────────── جهات الاتصال الطارئة ─────────────────────────
    match /emergency_contacts/{docId} {
      allow list, get: if true;
      allow create, update, delete: if isAdmin();
    }

    // ───────────────────────── معلومات القرية ─────────────────────────
    match /village_info/{docId} {
      allow list, get: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─────────────────────── التنبيه العاجل للقرية ───────────────────────
    // قراءة عامة لكل الشاشات؛ الإنشاء/التعديل/الحذف للمدير العام فقط.
    match /village_alerts/{docId} {
      allow list, get: if true;
      allow create, update, delete: if isAdmin();
    }

    // محتوى الخدمات الزراعية: قراءة عامة، وتحرير محصور بالمدير العام
    // ومدير الخدمات الزراعية. لا يمنح هذا الدور صلاحيات لوحة الأدمن العامة.
    match /agriculture_content/{docId} {
      allow list, get: if true;
      allow create, update, delete: if isAgriculturalAdmin();
    }

    // ───────────────────────── التعازي (مجموعة مستقلة) ─────────────────────────
    match /condolences/{docId} {
      allow list, get: if isSignedIn();
      allow create: if accountActive() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if isAdmin() || (accountActive() && request.auth.uid == resource.data.userId);
    }

    // ───────────────────────── حضور المناسبات ─────────────────────────
    match /occasion_attendees/{docId} {
      allow list, get: if isSignedIn();
      // الإنشاء يتحقق من request.resource، والحذف يتحقق من resource (الوثيقة القائمة)
      allow create: if accountActive() && request.auth.uid == request.resource.data.userId;
      allow delete: if accountActive() && (resource.data.userId == request.auth.uid || isAdmin());
      // مزامنة اسم الحاضر عند تغيير اسمه
      allow update: if isAdmin()
        || (accountActive() && resource.data.userId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userName']));
    }

    // ───────────────────────── مراجعات المنتجات ─────────────────────────
    match /product_reviews/{docId} {
      allow list, get: if true;
      allow create: if accountActive() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if isAdmin() || (accountActive() && request.auth.uid == resource.data.userId);
    }

    // ───────────────────────── مراجعات البائعين (reviews) ─────────────────────────
    match /reviews/{docId} {
      allow list, get: if true;
      allow create: if accountActive() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if isAdmin() || (accountActive() && request.auth.uid == resource.data.userId);
    }

    // ───────────────────────── ملفات البائعين ─────────────────────────
    match /seller_profiles/{docId} {
      allow list, get: if true;
      // الأدمن يستطيع إنشاء/تعديل أي ملف (عند الموافقة)، والمالك يعدّل ملفه
      allow create, update: if isAdmin() || isOwner(docId);
      allow delete: if isAdmin();
    }

    // ───────────────────────── طلبات أن تكون بائعاً ─────────────────────────
    match /seller_requests/{docId} {
      // الأدمن يرى الكل، والمقدِّم يرى طلبه فقط
      allow get: if isAdmin() || resource.data.userId == request.auth.uid;
      allow list: if isAdmin();
      allow create: if accountActive() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if isAdmin();
    }

    // ───────────────────────── تنبيهات المخزون ─────────────────────────
    match /stock_alerts/{docId} {
      allow list, get: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow create: if accountActive() && request.auth.uid == request.resource.data.userId;
      // الأدمن يحذفها ضمن تنظيف منتج محذوف
      allow delete: if isAdmin() || (accountActive() && request.auth.uid == resource.data.userId);
    }

    // ───────────────────────── الإشعارات ─────────────────────────
    match /notifications/{docId} {
      // خاص بالكامل: لا يقرأ أو يعدّل أحد إشعاراتِ غيره.
      allow get: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow list: if isSignedIn() && request.auth.uid == resource.data.userId;
      // الأدمن يوصّل إشعارات للآخرين؛ المستخدم يسجّل إشعارات نفسه فقط.
      allow create: if isAdmin()
                    || (accountActive()
                        && request.auth.uid == request.resource.data.userId);
      allow update: if accountActive() && request.auth.uid == resource.data.userId;
      allow delete: if isAdmin()
                    || (accountActive() && request.auth.uid == resource.data.userId);
    }

    // ───────────────────────── دليل الهاتف ─────────────────────────
    match /phone_directory/{docId} {
      allow list, get: if true;
      // لا يُنشئ المستخدم جهة اتصال معتمدة ذاتياً — تبدأ غير موافق عليه باسمه
      allow create: if isAdmin() || (accountActive()
          && request.resource.data.isApproved == false
          && request.auth.uid == request.resource.data.submittedBy);
      // مقدّم البيان يعدّل إدخاله في أي وقت (فيعود للمراجعة) ويحذفه فورًا.
      allow update: if isAdmin()
          || ownerEdit(resource.data.submittedBy,
                       request.resource.data.submittedBy);
      allow delete: if isAdmin() || ownerDelete(resource.data.submittedBy);
    }

    // ───────────────────────── دليل الخدمات (فنيون/زراعية/تعليمية) ─────────────────────────
    match /service_providers/{docId} {
      allow list, get: if true;
      // كل إدخال جديد يبدأ غير موافق عليه، ومن مقدم الطلب نفسه
      allow create: if accountActive()
                    && request.auth.uid == request.resource.data.submittedBy
                    && request.resource.data.isApproved == false;
      // الأدمن: مراجعة كاملة (موافقة/تمييز). المالك: يعدّل سجله في أي وقت
      // فيعود إلى المراجعة، دون لمس اسمه المطبّق من ملفه.
      // أي مستخدم مسجّل: تحديث إحصاءات التقييم فقط (rating/ratingCount) عند التعليق.
      allow update: if isAdmin()
                    || (accountActive() && resource.data.submittedBy == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['submittedByName']))
                    || (accountActive()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['rating', 'ratingCount']))
                    || (ownerEdit(resource.data.submittedBy,
                                  request.resource.data.submittedBy)
                        && !request.resource.data.diff(resource.data)
                             .affectedKeys().hasAny(['submittedByName']));
      allow delete: if isAdmin() || ownerDelete(resource.data.submittedBy);

      // تقييمات وتعليقات المستخدمين على البيانات
      match /comments/{commentId} {
        allow read: if true;
        allow create: if accountActive() && request.auth.uid == request.resource.data.userId;
        allow update, delete: if isAdmin() || (accountActive() && request.auth.uid == resource.data.userId);
      }
    }

    // ───────────────────────── المفقودات (أشياء مفقودة/موجودة) ─────────────────────────
    match /lost_items/{docId} {
      allow list, get: if true;
      // كل إعلان يبدأ غير معتمد، ومن صاحبه نفسه
      allow create: if accountActive()
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.isApproved == false;
      // الأدمن: مراجعة كاملة. المالك: يبدّل حالة «تم التسليم» بعد الاعتماد
      // (حالة لا تعدّل المضمون فلا تستحق مراجعة)، أو يعدّل إعلانَه في أي وقت
      // فيعود للمراجعة دون لمس نسبه، أو يحذفه فورًا.
      allow update: if isAdmin()
                    || (accountActive() && resource.data.userId == request.auth.uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['isResolved']))
                    || (ownerEdit(resource.data.userId, request.resource.data.userId)
                        && !request.resource.data.diff(resource.data)
                             .affectedKeys().hasAny(['userName']));
      allow delete: if isAdmin() || ownerDelete(resource.data.userId);
    }

    // ───────────────── إعلانات القرية (تجارية / خدمية / إنشائية) ─────────────────
    match /village_ads/{docId} {
      allow list, get: if true;
      // كل إعلان يبدأ غير معتمد، ومن صاحبه نفسه — فلا يمر عبر المراجعة إعلان
      // منسوب لغير كاتبه.
      allow create: if accountActive()
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.isApproved == false;
      // الأدمن والأدمن المساعد: مراجعة كاملة (موافقة/رفض/تعديل).
      // المالك: يعدّل بيانات إعلانه قبل الاعتماد وبعده — والتعديل يعيده إلى
      // طابور المراجعة بأمر القواعد — دون لمس نسبه (معرّفه واسمه المطبّق).
      allow update: if isAdmin()
                    || (ownerEdit(resource.data.userId, request.resource.data.userId)
                        && !request.resource.data.diff(resource.data)
                             .affectedKeys().hasAny(['userName']));
      allow delete: if isAdmin()
                    || ownerDelete(resource.data.userId);
    }

    // ─────────────────────── مستشار القرية: سجل المحامين ───────────────────────
    match /lawyers/{docId} {
      allow list, get: if true;
      allow create: if accountActive()
                    && request.auth.uid == request.resource.data.submittedBy
                    && request.resource.data.isApproved == false;
      allow update: if isAdmin()
                    || (ownerEdit(resource.data.submittedBy,
                                  request.resource.data.submittedBy)
                        && !request.resource.data.diff(resource.data)
                             .affectedKeys().hasAny(['submittedByName']));
      allow delete: if isAdmin()
                    || ownerDelete(resource.data.submittedBy);
    }

    // ────────────────── مستشار القرية: استشارات الأهالي القانونية ──────────────────
    // السؤال القانوني حسّاس: المعتمد فقط يُقرأ للعموم، وصاحب السؤال يرى
    // معلّقه، والرد (`answer`) يكتبه الأدمن وحده حتى لا يُنسب زورًا لمستشار.
    match /legal_consultations/{docId} {
      allow get: if isAdmin() || resource.data.isApproved == true
                 || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || resource.data.isApproved == true
                  || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if accountActive()
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.isApproved == false;
      // المالك: يصوغ سؤاله في أي وقت — فيعود للمراجعة — دون لمس نسبه أو الرد،
      // ودون أن يبقى عليه ردٌّ قديم: فبعد إعادة الصياغة يكون الرد السابق
      // إجابةً عن سؤالٍ لم يعد موجودًا، والخدمة تفرّغه والقواعد تثبت ذلك.
      allow update: if isAdmin()
                    || (ownerEdit(resource.data.userId, request.resource.data.userId)
                        && request.resource.data.answer == ''
                        && !request.resource.data.diff(resource.data)
                             .affectedKeys().hasAny(['userName']));
      allow delete: if isAdmin()
                    || ownerDelete(resource.data.userId);
    }

    // محلات القرية — الإنشاء لصاحب المحل (يبدأ غير معتمد)، والتعديل لصاحبه أو الأدمن
    match /shops/{docId} {
      allow list, get: if true;
      allow create: if isAdmin()
          || (accountActive()
              && request.auth.uid == request.resource.data.ownerUid
              && request.resource.data.isApproved == false);
      // المالك: يحدّث بيانات محله في أي وقت (فتعود للمراجعة) أو يزامن اسمه
      // المطبّق من ملفه، ويحذف محله فورًا.
      allow update: if isAdmin()
          || (accountActive() && resource.data.ownerUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerName']))
          || (ownerEdit(resource.data.ownerUid, request.resource.data.ownerUid)
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerName']));
      allow delete: if isAdmin() || ownerDelete(resource.data.ownerUid);
    }

    // سلع مطلوبة (تبويب «مطلوب» في سوق القرية) — كل طلب يبدأ غير معتمد ومن
    // صاحبه نفسه، والاعتماد قرار إداري لا يملك المالك كتابته لنفسه.
    match /buy_requests/{docId} {
      allow list, get: if true;
      allow create: if accountActive()
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.isApproved == false;
      // الأدمن: مراجعة كاملة. المالك: يبدّل حالته (مفتوح/مغلق) بعد الاعتماد —
      // حالة لا تعدّل المضمون فلا تستحق مراجعة ثانية، أو يزامن اسمه المطبّق من
      // ملفه، أو يعدّل طلبَه في أي وقت فيعود للمراجعة دون لمس نسبه، ويحذفه فورًا.
      allow update: if isAdmin()
                    || (accountActive() && resource.data.userId == request.auth.uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['status']))
                    || (accountActive() && resource.data.userId == request.auth.uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['userName']))
                    || ownerEdit(resource.data.userId, request.resource.data.userId);
      allow delete: if isAdmin() || ownerDelete(resource.data.userId);
    }

    // تبرعات (تبويب «تبرعات» في سوق القرية) — نفس عقد «مطلوب» حرفيًا.
    match /donations/{docId} {
      allow list, get: if true;
      allow create: if accountActive()
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.isApproved == false;
      // الحالة هنا هي «متاحة/تم التبرع بها» لا قرار الإدارة، فليست مقيّدة
      // بالاعتماد حتى تبقى بطاقة «تبرعاتي» عاملة بعد النشر.
      allow update: if isAdmin()
                    || (accountActive() && resource.data.userId == request.auth.uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['status']))
                    || (accountActive() && resource.data.userId == request.auth.uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['userName']))
                    || ownerEdit(resource.data.userId, request.resource.data.userId);
      allow delete: if isAdmin() || ownerDelete(resource.data.userId);
    }

    // ───────────────────────── سجل الأسعار ─────────────────────────
    match /price_history/{docId} {
      allow list, get: if true;
      allow create, update, delete: if isAdmin();
    }

    // ───────────────────────── الخدمات الطبية ─────────────────────────
    // عيادات المركز الطبي الخيري: العام للقراءة؛ يديرها مدير المركز الطبي
    // (وهي الصلاحية الوحيدة لهذا الدور) أو أي من المديرين العام/المساعد.
    // لا مالك للوثيقة: نموذج MedicalCenterClinic لا يحمل حقل مقدّم، والمركز
    // جهة لا فرد — فليست إضافة مستخدم تعدّل وتحذف نفسها، والإدارة هنا هي
    // صاحبها الوحيد عن قصد (لا يُفتعل حقل مالك لإعطائه صلاحية).
    match /medical_center_clinics/{docId} {
      allow list, get: if true;
      allow create, update, delete: if isCenterAdmin();
    }

    // عيادات القرية: مدخلات مستخدمين (تبدأ غير موافق عليها) + موافقة الأدمن.
    // مقدّم العيادة يعدّلها في أي وقت (فتعود للمراجعة) ويحذفها فورًا.
    match /village_clinics/{docId} {
      allow list, get: if true;
      allow create: if accountActive() && request.resource.data.isApproved == false;
      allow update: if isAdmin()
                    || (accountActive() && resource.data.submittedBy == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['submittedByName']))
                    || (ownerEdit(resource.data.submittedBy,
                                  request.resource.data.submittedBy)
                        && !request.resource.data.diff(resource.data)
                             .affectedKeys().hasAny(['submittedByName']));
      allow delete: if isAdmin() || ownerDelete(resource.data.submittedBy);
    }

    // صيدليات القرية: نفس نهج العيادات.
    match /pharmacies/{docId} {
      allow list, get: if true;
      allow create: if accountActive() && request.resource.data.isApproved == false;
      allow update: if isAdmin()
                    || (accountActive() && resource.data.submittedBy == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['submittedByName']))
                    || (ownerEdit(resource.data.submittedBy,
                                  request.resource.data.submittedBy)
                        && !request.resource.data.diff(resource.data)
                             .affectedKeys().hasAny(['submittedByName']));
      allow delete: if isAdmin() || ownerDelete(resource.data.submittedBy);
    }

    // معامل التحاليل: مدخلات مستخدمين (تبدأ غير موافق عليها) + موافقة الأدمن.
    match /medical_labs/{docId} {
      allow list, get: if true;
      allow create: if accountActive() && request.resource.data.isApproved == false;
      allow update: if isAdmin()
                    || (accountActive() && resource.data.submittedBy == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['submittedByName']))
                    || (ownerEdit(resource.data.submittedBy,
                                  request.resource.data.submittedBy)
                        && !request.resource.data.diff(resource.data)
                             .affectedKeys().hasAny(['submittedByName']));
      allow delete: if isAdmin() || ownerDelete(resource.data.submittedBy);
    }

    // بصريات القرية: مدخلات مستخدمين (تبدأ غير موافق عليها) + موافقة الأدمن.
    // المالك: يعدّل محله في أي وقت (فيعود إلى المراجعة)، ويجدّد نافذة عرضه
    // المميز وحدها (adType/featuredUntil) لأن التجديد ليس تعديل مضمون.
    match /optical_shops/{docId} {
      allow list, get: if true;
      allow create: if accountActive() && request.resource.data.isApproved == false;
      allow update: if isAdmin()
                    || (accountActive() && resource.data.submittedBy == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['adType', 'featuredUntil']))
                    || (accountActive() && resource.data.submittedBy == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['submittedByName']))
                    || ownerEdit(resource.data.submittedBy,
                                 request.resource.data.submittedBy);
      allow delete: if isAdmin() || ownerDelete(resource.data.submittedBy);
    }

    // متبرعو الدم: إضافة من المالك، ظهور عام بعد الموافقة، تعديل المالك لبياناته
    // في أي وقت (فيعود سجله إلى المراجعة)، وحذف فوري.
    match /blood_donors/{docId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if accountActive()
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.isApproved == false;
      // اسم المتبرِّع نسبه المطبّق من ملفه: يزامن وحده بلا إعادة مراجعة.
      allow update: if isAdmin()
                    || (accountActive() && resource.data.userId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']))
                    || ownerEdit(resource.data.userId, request.resource.data.userId);
      allow delete: if isAdmin() || ownerDelete(resource.data.userId);
    }

    // طلبات التبرع بالدم: المالك ينشئ/يغلق/يحدّث بيانات طلبه، والموافقة والنشر للأدمن.
    match /blood_requests/{docId} {
      allow list, get: if true;
      allow create: if accountActive()
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.isApproved == false;
      // المالك: إغلاق طلبه أو مزامنة اسمه (حالات لا تعدّل المضمون فلا تخرج
      // من الظهور)، أو تعديل طلبه في أي وقت فيعود للمراجعة. والحذف فوري.
      allow update: if isAdmin()
                    || (accountActive() && resource.data.userId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status','requesterName','phone']))
                    || ownerEdit(resource.data.userId, request.resource.data.userId);
      allow delete: if isAdmin() || ownerDelete(resource.data.userId);
    }

    // ───────────────────────── محتوى «تعرف على القرية» ─────────────────────────
    // قراءة عامة للجميع؛ الإنشاء/التعديل/الحذف للأدمن فقط (لا مراجعة — الأدمن هو المؤلف).
    match /village_history/{docId} {
      allow list, get: if true;
      allow write: if isAdmin();
    }

    match /village_figures/{docId} {
      allow list, get: if true;
      allow write: if isAdmin();
    }

    match /village_archive_photos/{docId} {
      allow list, get: if true;
      allow write: if isAdmin();
    }

    match /village_institutions/{docId} {
      allow list, get: if true;
      allow write: if isAdmin();
    }

    // ── أقسام المرجع الموسّع (كلها: قراءة عامة / كتابة للأدمن فقط) ──
    match /village_families/{docId} {
      allow list, get: if true;
      allow write: if isAdmin();
    }

    match /village_notable_people/{docId} {
      allow list, get: if true;
      allow write: if isAdmin();
    }

    match /village_memorial_people/{docId} {
      allow list, get: if true;
      allow write: if isAdmin();
    }

    match /village_heritage/{docId} {
      allow list, get: if true;
      allow write: if isAdmin();
    }

    match /village_landmarks/{docId} {
      allow list, get: if true;
      allow write: if isAdmin();
    }

    match /village_before_after/{docId} {
      allow list, get: if true;
      allow write: if isAdmin();
    }

    match /village_agriculture_history/{docId} {
      allow list, get: if true;
      allow write: if isAdmin();
    }

    match /village_education_history/{docId} {
      allow list, get: if true;
      allow write: if isAdmin();
    }

    match /village_development_timeline/{docId} {
      allow list, get: if true;
      allow write: if isAdmin();
    }

    match /village_achievements/{docId} {
      allow list, get: if true;
      allow write: if isAdmin();
    }

    // الأرشيف الرقمي: عرض عام للمواد المعتمدة، والكتابة للأدمن فقط.
    match /village_archive_items/{docId} {
      allow list, get: if true;
      allow write: if isAdmin();
    }

    // المساهمات المعتمدة فقط هي العامة؛ الإدارة تراها كاملة، وصاحب
    // المساهمة قيد المراجعة وحده يستطيع تعديلها دون حقن أي حقول حساسة.
    match /village_contributions/{docId} {
      allow get: if isAdmin() || resource.data.approvalStatus == 'approved';
      // القواعد لا تفحص فلاتر الاستعلام (request.query.where غير موجود):
      // الشرط يُقيَّم لكل مستند قد يرجعه الاستعلام، فيُرفض أي list لا يقيّد
      // نفسه بالمعتمد فقط — وهو ما يفعله استعلام التطبيق العام أصلاً.
      allow list: if isAdmin() || resource.data.approvalStatus == 'approved';
      allow create: if accountActive()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.approvalStatus == 'pending'
        && request.resource.data.pinOnHome == false
        && request.resource.data.keys().hasOnly([
          'userId', 'userName', 'type', 'title', 'description', 'imageUrl',
          'documentUrl', 'videoUrl', 'audioUrl', 'approvalStatus', 'createdAt',
          'reviewedAt', 'reviewedBy', 'pinOnHome'
        ])
        && request.resource.data.userId is string
        && request.resource.data.userName is string
        && request.resource.data.userName.size() <= 120
        && request.resource.data.type in ['photo', 'document', 'video', 'audio', 'info']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 10000
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 2000
        && request.resource.data.documentUrl is string
        && request.resource.data.documentUrl.size() <= 2000
        && request.resource.data.videoUrl is string
        && request.resource.data.videoUrl.size() <= 2000
        && request.resource.data.audioUrl is string
        && request.resource.data.audioUrl.size() <= 2000
        && request.resource.data.createdAt is timestamp
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedBy == null;
      allow update: if isAdmin()
        || (accountActive()
            && resource.data.userId == request.auth.uid
            && resource.data.approvalStatus == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['title', 'description', 'imageUrl', 'documentUrl',
                          'videoUrl', 'audioUrl', 'type'])
            && request.resource.data.userId == resource.data.userId
            && request.resource.data.userName == resource.data.userName
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.approvalStatus == resource.data.approvalStatus
            && request.resource.data.reviewedAt == resource.data.reviewedAt
            && request.resource.data.reviewedBy == resource.data.reviewedBy
            && request.resource.data.pinOnHome == resource.data.pinOnHome
            && request.resource.data.type in ['photo', 'document', 'video', 'audio', 'info']
            && request.resource.data.title is string
            && request.resource.data.title.size() > 0
            && request.resource.data.title.size() <= 200
            && request.resource.data.description is string
            && request.resource.data.description.size() <= 10000
            && request.resource.data.imageUrl is string
            && request.resource.data.imageUrl.size() <= 2000
            && request.resource.data.documentUrl is string
            && request.resource.data.documentUrl.size() <= 2000
            && request.resource.data.videoUrl is string
            && request.resource.data.videoUrl.size() <= 2000
            && request.resource.data.audioUrl is string
            && request.resource.data.audioUrl.size() <= 2000);
      allow delete: if isAdmin()
        || (accountActive() && resource.data.userId == request.auth.uid
            && resource.data.approvalStatus == 'pending');
    }

    // ───────────────────────── الإعلانات الدعائية المنبثقة ─────────────────────────
    // قراءة عامة (تظهر لكل المستخدمين) — الإنشاء/التعديل/الحذف للأدمن فقط.
    match /promos/{docId} {
      allow list, get: if true;
      allow write: if isAdmin() ||
        (isAgriculturalAdmin() && request.resource.data.placement in
          ['agri_fertilizers', 'agri_pesticides', 'agri_both']);
    }
  }
}