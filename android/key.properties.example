# إعدادات مفتاح توقيع تطبيق أندرويد لمتجر جوجل بلاي (Google Play Release Keystore)
# انسخ هذا الملف باسم key.properties في مجلد android/ وضع مسار وبيانات المفتاح الحقيقي
# تحذير: لا ترفع key.properties أو upload-keystore.jks إلى Git (مضافان تلقائياً في .gitignore)

keyAlias=upload
keyPassword=YOUR_KEY_PASSWORD
storeFile=../upload-keystore.jks
storePassword=YOUR_STORE_PASSWORD
